# ------------------------------------------------------------------
# Varen WhatsApp bot settings
# Copy this file, rename the copy to ".env" and fill in the values.
# On Render you type these same names/values into the "Environment" tab
# instead of using a .env file.
# NEVER share these values or upload the .env file to GitHub.
# ------------------------------------------------------------------

# --- OPTION 1: SmartPing (Pinbot) — Varen's setup ---
# API key SmartPing gave you
SMARTPING_API_KEY=
# A secret word you invent. Your webhook address becomes https://YOUR-BOT/webhook?key=THIS-WORD
WEBHOOK_KEY=
# PHONE_NUMBER_ID (below) is also needed: SmartPing gave you this too.

# --- OPTION 2: Meta directly (only if NOT using SmartPing; leave empty otherwise) ---
# (developers.facebook.com > your app > WhatsApp > API Setup)
# Permanent access token from your System User (starts with EAA...)
WHATSAPP_TOKEN=
# "Phone number ID" shown under your phone number (a long number, NOT the phone number itself)
PHONE_NUMBER_ID=
# Any password you invent. You will type the same word into Meta's webhook settings.
VERIFY_TOKEN=varen-verify-123
# App secret (App settings > Basic > App secret > Show). Recommended: proves messages really come from Meta.
APP_SECRET=

# --- From Anthropic (platform.claude.com > API keys) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Agent inbox ---
# Password your team types to open https://YOUR-BOT-ADDRESS/agent
AGENT_PASSWORD=change-this-password
# Optional: WhatsApp numbers of employees to alert when a customer needs a human.
# Country code + number, no + or spaces. Separate several with commas.
AGENT_NUMBERS=
# Optional: name of an approved Utility template used for the alert (see guide, Part 7), and its language code
AGENT_ALERT_TEMPLATE=
AGENT_ALERT_LANGUAGE=en
# The public address of your bot, e.g. https://varen-bot.onrender.com (used in alert messages)
PUBLIC_URL=

# --- Varen backend / CRM (leave empty to use data/sample-customers.json for testing) ---
CRM_API_URL=
CRM_API_KEY=

# --- Advanced (leave as is) ---
GRAPH_VERSION=v23.0
HANDOVER_TIMEOUT_HOURS=24
DATA_DIR=./data
PORT=3000
